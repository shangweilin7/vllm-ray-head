+def _round_up_to_supported_topk(topk: int) -> int:
+    """Round DSpark sparse-SWA index width to FlashInfer SM12x dispatch sizes."""
+    for supported_topk in (128, 512, 1024):
+        if topk <= supported_topk:
+            return supported_topk
+    raise ValueError(
+        f"Unsupported DSpark sparse-SWA topk={topk}; maximum supported is 1024."
+    )
+
